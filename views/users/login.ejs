    <a href="/" class="flex items-center space-x-3 rtl:space-x-reverse">
        <img src="/img/logo.jpg" class="bg-white rounded-full w-10 h-10">
        <span class="self-center text-2xl font-semibold whitespace-nowrap">UMSRT</span>
    </a>
    
    <div class="flex flex-row gap-5 items-center justify-center">
        <a href="/#home" class="text-sm font-semibold text-gray-700">Home</a>
        <a href="/#overview" class="text-sm font-semibold text-gray-700">Overview</a>
        <a href="/#features" class="text-sm font-semibold text-gray-700">Features</a>
