<div class="bg-blue-100 w-screen h-screen overflow-y-auto items-center justify-center flex">
    <div class="bg-white fixed top-0 w-full h-15 flex flex-row items-center justify-between">
        <a href="" class="flex items-center space-x-3">
            <img src="/img/logo.jpg" class="bg-white rounded-full w-12 h-auto">
            <span class="self-center text-sm lg:text-2xl font-semibold whitespace-nowrap">UMSRT | </span>
            <span class="self-center text-xs lg:text-sm font-semibold whitespace-nowrap">User Account</span>
        </a>
        <a href="/users/logout">
            <button type="button" class="py-2.5 px-5 me-2 text-sm font-medium text-gray-900 focus:outline-none bg-white rounded-lg border border-gray-200 hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:ring-gray-100">Log out</button>
        </a>
    </div>
    <div class="p-5 w-[95%] lg:!w-[80%] mt-20">
        <div class="w-full overflow-y-auto p-4 rounded-2xl shadow-2xl bg-white flex flex-col lg:flex-row">
            <div class="border-b border-gray-300 lg:!border-b-0 lg:border-r lg:border-gray-300 lg:w-[30%]">
                <div class=" flex flex-col">
                    <div class="flex flex-row gap-2 items-center p-2 mb-2">
                        <div class="bg-emerald-600 w-12 h-12 rounded-full flex flex-row items-center justify-center text-white">
                            <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M224 256A128 128 0 1 0 224 0a128 128 0 1 0 0 256zm-45.7 48C79.8 304 0 383.8 0 482.3C0 498.7 13.3 512 29.7 512l388.6 0c16.4 0 29.7-13.3 29.7-29.7C448 383.8 368.2 304 269.7 304l-91.4 0z"/></svg>
                        </div>
                        <div class="flex flex-col gap-0 justify-center">
                            <p class="text-black font-normal text-sm">Hello,</p>
                            <p class="text-black font-bold text-sm"><%= userdata.form_data.data.first_name %> <%= userdata.form_data.data.last_name %></p>
                            <div class="flex flex-row items-center gap-2 mt-2">
                                <svg class="w-3 h-3 fill-current text-gray-500" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M96 32l0 32L48 64C21.5 64 0 85.5 0 112l0 48 448 0 0-48c0-26.5-21.5-48-48-48l-48 0 0-32c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 32L160 64l0-32c0-17.7-14.3-32-32-32S96 14.3 96 32zM448 192L0 192 0 464c0 26.5 21.5 48 48 48l352 0c26.5 0 48-21.5 48-48l0-272z"/></svg>
                                <p class="text-black font-normal text-xs"><%= userdata.date_added %></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="h-full w-full flex flex-col lg:pl-5 lg:w-[70%]">
                <div class="flex flex-row gap-2 items-center justify-start mt-2 lg:items-start lg:h-fit overflow-x-auto pb-3">
                    <button id="personalbtn" type="button" class="flex flex-row gap-2 items-center py-2.5 px-2 me-2 text-xs font-medium text-gray-900 focus:outline-none bg-white-600 rounded-lg">
                        <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l448 0c35.3 0 64-28.7 64-64l0-320c0-35.3-28.7-64-64-64L64 32zm80 256l64 0c44.2 0 80 35.8 80 80c0 8.8-7.2 16-16 16L80 384c-8.8 0-16-7.2-16-16c0-44.2 35.8-80 80-80zm-32-96a64 64 0 1 1 128 0 64 64 0 1 1 -128 0zm256-32l128 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-128 0c-8.8 0-16-7.2-16-16s7.2-16 16-16zm0 64l128 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-128 0c-8.8 0-16-7.2-16-16s7.2-16 16-16zm0 64l128 0c8.8 0 16 7.2 16 16s-7.2 16-16 16l-128 0c-8.8 0-16-7.2-16-16s7.2-16 16-16z"/></svg>
                        Personal</button>
                    <button id="jobbtn" type="button" class="flex flex-row gap-2 items-center py-2.5 px-2 me-2 text-xs font-medium text-gray-900 focus:outline-none bg-white rounded-lg">
                        <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M184 48l144 0c4.4 0 8 3.6 8 8l0 40L176 96l0-40c0-4.4 3.6-8 8-8zm-56 8l0 40L64 96C28.7 96 0 124.7 0 160l0 96 192 0 128 0 192 0 0-96c0-35.3-28.7-64-64-64l-64 0 0-40c0-30.9-25.1-56-56-56L184 0c-30.9 0-56 25.1-56 56zM512 288l-192 0 0 32c0 17.7-14.3 32-32 32l-64 0c-17.7 0-32-14.3-32-32l0-32L0 288 0 416c0 35.3 28.7 64 64 64l384 0c35.3 0 64-28.7 64-64l0-128z"/></svg>
                        Job</button>
                    <button id="educationbtn" type="button" class="flex flex-row gap-2 items-center py-2.5 px-2 me-2 text-xs font-medium text-gray-900 focus:outline-none bg-white rounded-lg">
                        <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M320 32c-8.1 0-16.1 1.4-23.7 4.1L15.8 137.4C6.3 140.9 0 149.9 0 160s6.3 19.1 15.8 22.6l57.9 20.9C57.3 229.3 48 259.8 48 291.9l0 28.1c0 28.4-10.8 57.7-22.3 80.8c-6.5 13-13.9 25.8-22.5 37.6C0 442.7-.9 448.3 .9 453.4s6 8.9 11.2 10.2l64 16c4.2 1.1 8.7 .3 12.4-2s6.3-6.1 7.1-10.4c8.6-42.8 4.3-81.2-2.1-108.7C90.3 344.3 86 329.8 80 316.5l0-24.6c0-30.2 10.2-58.7 27.9-81.5c12.9-15.5 29.6-28 49.2-35.7l157-61.7c8.2-3.2 17.5 .8 20.7 9s-.8 17.5-9 20.7l-157 61.7c-12.4 4.9-23.3 12.4-32.2 21.6l159.6 57.6c7.6 2.7 15.6 4.1 23.7 4.1s16.1-1.4 23.7-4.1L624.2 182.6c9.5-3.4 15.8-12.5 15.8-22.6s-6.3-19.1-15.8-22.6L343.7 36.1C336.1 33.4 328.1 32 320 32zM128 408c0 35.3 86 72 192 72s192-36.7 192-72L496.7 262.6 354.5 314c-11.1 4-22.8 6-34.5 6s-23.5-2-34.5-6L143.3 262.6 128 408z"/></svg>
                        Education</button>
                    <button id="accountbtn" type="button" class="flex flex-row gap-2 items-center py-2.5 px-2 me-2 text-xs font-medium text-gray-900 focus:outline-none bg-white rounded-lg">
                        <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M495.9 166.6c3.2 8.7 .5 18.4-6.4 24.6l-43.3 39.4c1.1 8.3 1.7 16.8 1.7 25.4s-.6 17.1-1.7 25.4l43.3 39.4c6.9 6.2 9.6 15.9 6.4 24.6c-4.4 11.9-9.7 23.3-15.8 34.3l-4.7 8.1c-6.6 11-14 21.4-22.1 31.2c-5.9 7.2-15.7 9.6-24.5 6.8l-55.7-17.7c-13.4 10.3-28.2 18.9-44 25.4l-12.5 57.1c-2 9.1-9 16.3-18.2 17.8c-13.8 2.3-28 3.5-42.5 3.5s-28.7-1.2-42.5-3.5c-9.2-1.5-16.2-8.7-18.2-17.8l-12.5-57.1c-15.8-6.5-30.6-15.1-44-25.4L83.1 425.9c-8.8 2.8-18.6 .3-24.5-6.8c-8.1-9.8-15.5-20.2-22.1-31.2l-4.7-8.1c-6.1-11-11.4-22.4-15.8-34.3c-3.2-8.7-.5-18.4 6.4-24.6l43.3-39.4C64.6 273.1 64 264.6 64 256s.6-17.1 1.7-25.4L22.4 191.2c-6.9-6.2-9.6-15.9-6.4-24.6c4.4-11.9 9.7-23.3 15.8-34.3l4.7-8.1c6.6-11 14-21.4 22.1-31.2c5.9-7.2 15.7-9.6 24.5-6.8l55.7 17.7c13.4-10.3 28.2-18.9 44-25.4l12.5-57.1c2-9.1 9-16.3 18.2-17.8C227.3 1.2 241.5 0 256 0s28.7 1.2 42.5 3.5c9.2 1.5 16.2 8.7 18.2 17.8l12.5 57.1c15.8 6.5 30.6 15.1 44 25.4l55.7-17.7c8.8-2.8 18.6-.3 24.5 6.8c8.1 9.8 15.5 20.2 22.1 31.2l4.7 8.1c6.1 11 11.4 22.4 15.8 34.3zM256 336a80 80 0 1 0 0-160 80 80 0 1 0 0 160z"/></svg>
                        Account</button>
                </div>
                <div class="lg:w-[50%]">
                    <form id="personalinfoform" class="hidden w-full mt-5 h-full">
                        <p class="text-sm font-semibold text-black">Personal Information</p>
                        <div class="h-full flex flex-col justify-between">
                            <div class="flex flex-col h-auto">
                                <div class="flex flex-col gap-4 mt-2">
                                    <div class="w-full">
                                        <label for="first_name" class="block mb-2 text-xs font-medium text-gray-900">First name</label>
                                        <input value="<%= userdata.form_data.data.first_name %>" type="text" id="first_name" name="first_name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Juan" required />
                                    </div>
                                    <div class="w-full">
                                        <label for="middle_name" class="block mb-2 text-xs font-medium text-gray-900">Middle name</label>
                                        <input value="<%= userdata.form_data.data.middle_name %>" type="text" id="middle_name" name="middle_name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Dela" required />
                                    </div>
                                    <div class="w-full">
                                        <label for="last_name" class="block mb-2 text-xs font-medium text-gray-900">Last name</label>
                                        <input value="<%= userdata.form_data.data.last_name %>" type="text" id="last_name" name="last_name" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Cruz" required />
                                    </div>
                                </div>
                                <div class="flex flex-row gap-4 mt-2">
                                    <div class="w-full">
                                        <label for="date_of_birth" class="block mb-2 text-xs font-medium text-gray-900">Date of Birth</label>
                                        <input value="<%= userdata.form_data.data.date_of_birth %>" type="date" id="date_of_birth" name="date_of_birth" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="MM/DD/YYYY" required />
                                    </div>
                                    <div class="w-full">
                                        <label for="age" class="block mb-2 text-xs font-medium text-gray-900">Age</label>
                                        <input value="<%= userdata.form_data.data.age %>" type="text" id="age" name="age" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., 30" required readonly />
                                    </div>
                                </div>

                                <div class="mt-2 w-full">
                                    <label for="barangay" class="block mb-2 text-xs font-medium text-gray-900">Barangay</label>
                                    <% const barangays = [
                                        "Alegria", "Balangasan", "Balintawak", "Baloyboan", "Banale", "Bogo", "Bomba", "Buenavista",
                                        "Bulatok", "Bulawan", "Dampalan", "Danlugan", "Dao", "Datagan", "Deborok", "Ditoray", "Dumagoc",
                                        "Gatas", "Gubac", "Gubang", "Kagawasan", "Kahayagan", "Kalasan", "Kawit", "La Suerte", "Lala",
                                        "Lapidian", "Lenienza", "Lizon Valley", "Lordes", "Lower Sibatang", "Lumad", "Lumbia", "Macasing",
                                        "Manga", "Muricay", "Napolan", "Palpalan", "Pedulonan", "Poloyagan", "San Francisco", "San Jose",
                                        "San Pedro", "Sta. Lucia", "Sta. Maria", "Santiago", "Sto. Niño", "Tawagan Sur", "Tiguma",
                                        "Tuburan", "Tulangan", "Tulawas", "Upper Sibatang", "White Beach"
                                    ]; %>

                                    <select id="barangay" name="barangay"
                                        class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5"
                                        required>
                                        <option value="">Choose your Barangay</option>
                                        <% barangays.forEach(function(b) { %>
                                            <option value="<%= b %>" <%= userdata.form_data.data.barangay === b ? 'selected' : '' %>><%= b %></option>
                                        <% }); %>
                                    </select>

                                </div>
                            </div>
            
                            <button type="submit" class="self-end flex flex-row items-center justify-center gap-2 w-full mb-10 mt-8 px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-lg focus:ring-4 focus:ring-blue-300 hover:bg-blue-800 focus:outline-none">
                                <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-242.7c0-17-6.7-33.3-18.7-45.3L352 50.7C340 38.7 323.7 32 306.7 32L64 32zm0 96c0-17.7 14.3-32 32-32l192 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32L96 224c-17.7 0-32-14.3-32-32l0-64zM224 288a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/></svg>
                                Update
                            </button>
                        </div>
                    </form>

                    <form id="jobform" class="hidden w-full mt-5">
                        <p class="text-sm font-semibold text-black">Job History and Career Plans</p>
                        <p class="text-sm text-gray-700 font-normal mb-4">Leave empty if no job history or currently unemployed.</p>
                        <div class="h-full flex flex-col">
                            <div class="flex flex-col h-auto">
                                <div class="flex flex-col gap-4 mb-2">
                                    <div class="w-full">
                                        <label for="previous_employment_1" class="block mb-2 text-xs font-medium text-gray-900">Previous Employment 1</label>
                                        <input value="<%= userdata.form_data.data.previous_employment_1 %>" type="text" id="previous_employment_1" name="previous_employment_1" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Company Name, Position" />
                                    </div>
                                    <div class="w-full">
                                        <label for="previous_employment_2" class="block mb-2 text-xs font-medium text-gray-900">Previous Employment 2</label>
                                        <input value="<%= userdata.form_data.data.previous_employment_2 %>" type="text" id="previous_employment_2" name="previous_employment_2" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Optional: Company Name, Position" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-4 mt-2 mb-2">
                                    <div class="w-full">
                                        <label for="current_employment_1" class="block mb-2 text-xs font-medium text-gray-900">Current Employment 1</label>
                                        <input value="<%= userdata.form_data.data.current_employment_1 %>" type="text" id="current_employment_1" name="current_employment_1" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Current Company, Position" />
                                    </div>
                                    <div class="w-full">
                                        <label for="current_employment_2" class="block mb-2 text-xs font-medium text-gray-900">Current Employment 2</label>
                                        <input value="<%= userdata.form_data.data.current_employment_2 %>" type="text" id="current_employment_2" name="current_employment_2" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Optional: Current Company, Position" />
                                    </div>
                                </div>

                                <div class="flex flex-col gap-4 mt-2 mb-2">
                                    <div class="w-full">
                                        <label for="future_employment_1" class="block mb-2 text-xs font-medium text-gray-900">Future Employment 1</label>
                                        <input value="<%= userdata.form_data.data.future_employment_1 %>" type="text" id="future_employment_1" name="future_employment_1" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Desired Role, Industry" />
                                    </div>
                                    <div class="w-full">
                                        <label for="future_employment_2" class="block mb-2 text-xs font-medium text-gray-900">Future Employment 2</label>
                                        <input value="<%= userdata.form_data.data.future_employment_2 %>" type="text" id="future_employment_2" name="future_employment_2" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="Optional: Another desired role" />
                                    </div>
                                </div>
                            </div>
            
                            <button type="submit" class="self-end flex flex-row items-center justify-center gap-2 w-full mb-10 mt-8 px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-lg focus:ring-4 focus:ring-blue-300 hover:bg-blue-800 focus:outline-none">
                                <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-242.7c0-17-6.7-33.3-18.7-45.3L352 50.7C340 38.7 323.7 32 306.7 32L64 32zm0 96c0-17.7 14.3-32 32-32l192 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32L96 224c-17.7 0-32-14.3-32-32l0-64zM224 288a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/></svg>
                                Update
                            </button>
                        </div>
                    </form>

                    <form id="educationform" class="hidden w-full mt-5">
                        <p class="text-sm font-semibold text-black mb-4">Education</p>
                        <div class="h-full flex flex-col">
                            <div class="flex flex-col h-auto">
                                <div class="w-full">
                                    <label for="elementary_education" class="block mb-2 text-xs font-medium text-gray-900">Elementary</label>
                                    <input type="text" value="<%= userdata.form_data.data.elementary_education %>" id="elementary_education" name="elementary_education" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., School Name, Year Graduated" required />
                                </div>
                                <div class="w-full mt-4">
                                    <label for="high_school_education" class="block mb-2 text-xs font-medium text-gray-900">High School</label>
                                    <input type="text" value="<%= userdata.form_data.data.high_school_education %>" id="high_school_education" name="high_school_education" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., School Name, Year Graduated" required />
                                </div>
                                <div class="w-full mt-4">
                                    <label for="college_education" class="block mb-2 text-xs font-medium text-gray-900">College</label>
                                    <input type="text" value="<%= userdata.form_data.data.college_education %>" id="college_education" name="college_education" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., University Name, Year Graduated" required />
                                </div>
                                <div class="w-full mt-4">
                                    <label for="course_taken" class="block mb-2 text-xs font-medium text-gray-900">Course</label>
                                    <input type="text" value="<%= userdata.form_data.data.course_taken %>" id="course_taken" name="course_taken" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., Bachelor of Science in IT" required />
                                </div>
                            </div>
            
                            <button type="submit" class="self-end flex flex-row items-center justify-center gap-2 w-full mb-10 mt-8 px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-lg focus:ring-4 focus:ring-blue-300 hover:bg-blue-800 focus:outline-none">
                                <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-242.7c0-17-6.7-33.3-18.7-45.3L352 50.7C340 38.7 323.7 32 306.7 32L64 32zm0 96c0-17.7 14.3-32 32-32l192 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32L96 224c-17.7 0-32-14.3-32-32l0-64zM224 288a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/></svg>
                                Update
                            </button>
                        </div>
                    </form>

                    <form id="accountform" class="hidden w-full mt-5">
                        <p class="text-sm font-semibold text-black mb-4">Account Settings</p>
                        <div class="h-full flex flex-col">
                            <div class="flex flex-col h-auto">
                                <div class="w-full">
                                    <label for="email" class="block mb-2 text-xs font-medium text-gray-900">Email</label>
                                    <input readonly value="<%= userdata.form_data.data.email %>" type="email" id="email" name="email" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" placeholder="e.g., School Name, Year Graduated" required />
                                </div>
                                <div class="w-full mt-4">
                                    <label for="high_school_education" class="block mb-2 text-xs font-medium text-gray-900">New Password</label>
                                    <input type="password" id="account_password" name="account_password" 
                                    class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5" 
                                    placeholder="Enter at least 6 characters" required minlength="6" />
                                </div>
                            </div>
            
                            <button type="submit" class="self-end flex flex-row items-center justify-center gap-2 w-full mb-10 mt-8 px-5 py-2.5 text-sm font-medium text-white bg-blue-700 rounded-lg focus:ring-4 focus:ring-blue-300 hover:bg-blue-800 focus:outline-none">
                                <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><!--!Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2025 Fonticons, Inc.--><path d="M64 32C28.7 32 0 60.7 0 96L0 416c0 35.3 28.7 64 64 64l320 0c35.3 0 64-28.7 64-64l0-242.7c0-17-6.7-33.3-18.7-45.3L352 50.7C340 38.7 323.7 32 306.7 32L64 32zm0 96c0-17.7 14.3-32 32-32l192 0c17.7 0 32 14.3 32 32l0 64c0 17.7-14.3 32-32 32L96 224c-17.7 0-32-14.3-32-32l0-64zM224 288a64 64 0 1 1 0 128 64 64 0 1 1 0-128z"/></svg>
                                Update
                            </button>
                        </div>
                    </form>
                </div>
            </div>
            
        </div>
    </div>
</div>