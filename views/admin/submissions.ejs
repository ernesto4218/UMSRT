<div class="w-full h-full bg-blue-50 rounded-tl-4xl relative flex overflow-y-auto p-5">
    <table id="search-table">
        <thead>
            <tr>
                <th>
                    <span class="flex submissions-center">
                        Id
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Full Name
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Email
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Date Of Birth
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Age
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Barangay
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Previous Employment
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Current Employment
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                 <th>
                    <span class="flex submissions-center">
                        Future Employment
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Skills & Experience
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Elementary
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        High School
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        College
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Last Edited
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Date Added
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Action
                    </span>
                </th>
            </tr>
        </thead>
        <tbody>
            <% if (allsubmissions) { %>
                <% allsubmissions.forEach(submission => { %>
                <tr>
                    <td class="max-w-[120px] truncate "><%= submission.id %></td>
                    <td class="max-w-[250px] truncate " title="<%= submission.form_data.data.first_name + ' ' + submission.form_data.data.last_name %>">
                    <%= submission.form_data.data.first_name %> <%= submission.form_data.data.last_name %>
                    </td>
                    <td class="max-w-[300px] truncate " title="<%= submission.email %>"><%= submission.email %></td>
                    <td class="max-w-[140px] truncate "><%= submission.form_data.data.date_of_birth %></td>
                    <td class="max-w-[80px] truncate "><%= submission.form_data.data.age %></td>
                    <td class="max-w-[150px] truncate "><%= submission.form_data.data.barangay %></td>
                    <td class="max-w-[200px] truncate " title="<%= submission.form_data.data.previous_employment_1 || submission.form_data.data.previous_employment_2 %>">
                    <%= submission.form_data.data.previous_employment_1 || submission.form_data.data.previous_employment_2 %>
                    </td>
                    <td class="max-w-[200px] truncate " title="<%= submission.form_data.data.current_employment_1 || submission.form_data.data.current_employment_2 %>">
                    <%= submission.form_data.data.current_employment_1 || submission.form_data.data.current_employment_2 %>
                    </td>
                    <td class="max-w-[200px] truncate " title="<%= submission.form_data.data.future_employment_1 || submission.form_data.data.future_employment_2 %>">
                    <%= submission.form_data.data.future_employment_1 || submission.form_data.data.future_employment_2 %>
                    </td>
                    <td class="max-w-[200px] truncate " title="<%= submission.form_data.data.your_skills %>"><%= submission.form_data.data.your_skills %></td>
                    <td class="max-w-[200px] truncate "><%= submission.form_data.data.elementary_education %></td>
                    <td class="max-w-[200px] truncate "><%= submission.form_data.data.high_school_education %></td>
                    <td class="max-w-[200px] truncate "><%= submission.form_data.data.college_education %></td>
                    <td class="max-w-[160px] truncate "><%= submission.date_modified %></td>
                    <td class="max-w-[160px] truncate "><%= submission.date_added %></td>
                    <td class="max-w-[100px] truncate ">
                    <span 
                        data-submission="<%= JSON.stringify(submission) %>" 
                        class="viewsubmittedbtn cursor-pointer bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-sm"
                    >
                        View
                    </span>
                    </td>
                </tr>
                <% }) %>
            <% } %>
            </tbody>

    </table>
</div>
