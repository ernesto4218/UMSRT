<div class="w-full h-full bg-blue-50 rounded-tl-4xl relative flex flex-row overflow-y-auto p-5 gap-5">
   <div class="flex flex-col p-5 bg-white rounded-2xl shadow-sm overflow-y-auto w-3xl">
        <p class="text-sm font-semibold text-gray-900 mb-4">Automation</p>
        <div class="flex flex-col w-full justify-start">

            <div class="inline-flex flex-col w-full mb-10">
                <label class="inline-flex items-start cursor-pointer w-fit">
                    <div class="flex flex-col">
                        <span class="ms-3 text-sm font-medium text-gray-900">Post on facebook</span>
                        <span class="ms-3 text-xs font-normal text-gray-900">Post on facebok from UMSRT page</span>
                    </div>
                </label>

                <textarea id="custom_message" rows="5" class="mt-3 p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Write your thoughts here..."></textarea>

                <button id="postnowresultsbtncustom" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mt-5 w-fit flex flex-row items-center gap-2 self-end">
                    Post Now
                    <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>
                </button>
            </div>

            <div class="inline-flex flex-col w-full">
                <label class="inline-flex items-start cursor-pointer w-fit">
                    <input type="checkbox" value="" class="sr-only peer" <% if (config[0].active === 1) { %>
                     checked
                    <% } %>>
                    <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-1 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600 dark:peer-checked:bg-blue-600"></div>
                    <div class="flex flex-col">
                    <span class="ms-3 text-sm font-medium text-gray-900">Daily Results</span>
                    <span class="ms-3 text-xs font-normal text-gray-900">Post daily results every day on form submissions. Every 10AM PH time</span>
                    </div>
                </label>

                <textarea id="message1" rows="20" class="pl-14 mt-3 p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Write your thoughts here...">
<%= config[0].message %>
                </textarea>

                <button id="postnowresultsbtn" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mt-5 w-fit flex flex-row items-center gap-2 self-end">
                    Post Now
                    <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>
                </button>
            </div>

            <div class="inline-flex flex-col w-full mt-10">
                <label class="inline-flex items-start cursor-pointer mt-2">
                    <input type="checkbox" value="" class="sr-only peer"<% if (config[0].active === 1) { %>
                     checked
                    <% } %>>
                    <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none peer-focus:ring-1 peer-focus:ring-blue-300 dark:peer-focus:ring-blue-800 rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-blue-600 dark:peer-checked:bg-blue-600"></div>
                    <div class="flex flex-col">
                        <span class="ms-3 text-sm font-medium text-gray-900">Daily Submission</span>
                        <span class="ms-3 text-xs font-normal text-gray-900">Post daily of form submission link. Every 11AM PH time</span>
                    </div>
                </label>

                <textarea id="message" rows="20" class="pl-14 mt-3 p-2.5 w-full text-sm text-gray-900 bg-gray-50 rounded-lg border border-gray-300 focus:ring-blue-500 focus:border-blue-500" placeholder="Write your thoughts here...">
<%= config[1].message %>
                </textarea>

                 <button id="postnowpromobtn" type="button" class="text-white bg-blue-700 hover:bg-blue-800 focus:ring-4 focus:ring-blue-300 font-medium rounded-lg text-sm px-5 py-2.5 me-2 mt-5 w-fit flex flex-row items-center gap-2 self-end">
                    Post Now
                    <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512"><path d="M438.6 278.6c12.5-12.5 12.5-32.8 0-45.3l-160-160c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L338.8 224 32 224c-17.7 0-32 14.3-32 32s14.3 32 32 32l306.7 0L233.4 393.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0l160-160z"/></svg>
                </button>
            </div>            
        </div>
   </div>

   <div class="flex flex-col p-5 bg-white rounded-2xl shadow-sm overflow-y-auto w-full">
        <div class="border-b border-gray-300">
            <p class="text-sm font-semibold text-gray-900 mb-4">Facebook Page</p>
            <div class="relative">
                <img src="/img/mapbgmin.png" class="w-full h-[200px] object-cover rounded-xl brightness-80" alt="">
                <a href="https://www.facebook.com/profile.php?id=61578817250829" target="_blank" rel="noopener noreferrer">
                    <div class="w-fit flex flex-row  absolute bottom-5 left-5 items-center gap-3">
                        <img src="/img/logo.jpg" class="w-20 h-20 border-4 border-emerald-600 shadow-2xl object-cover rounded-full" alt="">
                        <div class="flex flex-row items-center gap-3">
                            <p class="text-xl text-white font-bold">UMSRT</p>
                            <svg class="w-3 h-3 fill-current text-white" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M320 0c-17.7 0-32 14.3-32 32s14.3 32 32 32l82.7 0L201.4 265.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L448 109.3l0 82.7c0 17.7 14.3 32 32 32s32-14.3 32-32l0-160c0-17.7-14.3-32-32-32L320 0zM80 32C35.8 32 0 67.8 0 112L0 432c0 44.2 35.8 80 80 80l320 0c44.2 0 80-35.8 80-80l0-112c0-17.7-14.3-32-32-32s-32 14.3-32 32l0 112c0 8.8-7.2 16-16 16L80 448c-8.8 0-16-7.2-16-16l0-320c0-8.8 7.2-16 16-16l112 0c17.7 0 32-14.3 32-32s-14.3-32-32-32L80 32z"/></svg>
                        </div>
                    </div>
                </a>
            </div>
        </div>
        <p class="text-sm font-semibold text-gray-900 my-4">Post History</p>
        <table id="search-table">
        <thead>
            <tr>
                <th>
                    <span class="flex submissions-center">
                        Id
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Content
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Status
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                <th>
                    <span class="flex submissions-center">
                        Date Posted
                        <svg class="w-4 h-4 ms-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m8 15 4 4 4-4m0-6-4-4-4 4"/>
                        </svg>
                    </span>
                </th>
                
            </tr>
        </thead>
        <tbody>
           <% allposts.forEach(post => { %>
            <tr>
                <td><%= post.id %></td>
                <td><%= post.content %></td>
                <td>
                    <span class="text-xs font-medium me-2 px-2.5 py-0.5 rounded-sm 
                        <% if (post.status === 'Success') { %> 
                        bg-green-100 text-green-800 
                        <% } else if (post.status === 'Failed') { %> 
                        bg-red-100 text-red-800 
                        <% } else { %>
                        bg-gray-100 text-gray-800 
                        <% } %>">
                        <%= post.status %>
                    </span>
                </td>
                <td><%= post.date_added %></td>
            </tr>
           <% }) %>
        </tbody>
    </table>
   </div>
</div>
