<div id="submissionanalyticscontainer" class="hidden flex-col">
    <div class="fixed z-50 w-screen h-screen flex items-center justify-center">
        <div class="w-[80%] h-[70%] overflow-y-auto bg-white rounded-2xl flex flex-col">

            <div class="flex justify-between p-4">
                <div>
                    <h5 class="submissioncount leading-none text-3xl font-bold text-gray-900 pb-2">0</h5>
                    <p class="text-base font-normal text-gray-500">Submissions</p>
                </div>
                <div class="closesubmissionanalyticsbtn p-2 bg-gray-100 rounded-xl cursor-pointer text-gray-500 w-fit h-fit">
                    <svg class="w-4 h-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 384 512">
                    <path d="M342.6 150.6c12.5-12.5 12.5-32.8 0-45.3s-32.8-12.5-45.3 0L192 210.7 86.6 105.4c-12.5-12.5-32.8-12.5-45.3 0s-12.5 32.8 0 45.3L146.7 256 41.4 361.4c-12.5 12.5-12.5 32.8 0 45.3s32.8 12.5 45.3 0L192 301.3 297.4 406.6c12.5 12.5 32.8 12.5 45.3 0s12.5-32.8 0-45.3L237.3 256 342.6 150.6z"/>
                    </svg>
                </div>
            </div>
            
            <div class="flex flex-row overflow-y-auto h-[300px]">

                <div class="w-full bg-white rounded-lg shadow-sm md:p-6">
                    <div class="overflow-x-auto w-full p-5 overflow-y-hidden">
                        <div id="column-chart" class="w-full overflow-x-auto overflow-y-hidden"></div>
                    </div>

                    <form class="w-fit self-start px-5">
                        <label for="barangay-select" class="block mb-2 text-sm font-medium text-gray-900 dark:text-white">Select barangay</label>
                        <select id="barangay-select" class="bg-gray-50 border border-gray-300 text-gray-900 text-sm rounded-lg focus:ring-blue-500 focus:border-blue-500 block w-full p-2.5 dark:bg-gray-700 dark:border-gray-600 dark:placeholder-gray-400 dark:text-white dark:focus:ring-blue-500 dark:focus:border-blue-500">
                            <option value="all">All Barangays</option>
                            <% allBarangays.forEach(barangay => { %>
                                <option value="<%= barangay.name %>"><%= barangay.name %></option>
                            <% }) %>
                        </select>
                    </form>

                    <div class="overflow-x-auto w-full p-5 overflow-y-hidden">
                        <div id="column-chart2"  class="w-full overflow-x-auto overflow-y-hidden"></div>
                    </div>


                </div>
            </div>

        </div>
    </div>

    <div class="fixed w-screen h-screen z-40 bg-black/50 backdrop-blur-xs">
        <div class="w-full h-full backdrop-blur-sm"></div>
    </div>
</div>
