<script>
    const birthInput = document.getElementById('date_of_birth');
    const ageInput = document.getElementById('age');

    birthInput.addEventListener('change', () => {
        const birthDate = new Date(birthInput.value);
        const today = new Date();

        let age = today.getFullYear() - birthDate.getFullYear();
        const m = today.getMonth() - birthDate.getMonth();

        if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
            age--;
        }

        ageInput.value = birthInput.value ? age : '';
    });

    const form = document.getElementById("submissionForm");

    // 👇 Fill form with sample values
    function fillFormWithSampleData() {
        form.first_name.value = "Juan";
        form.middle_name.value = "Dela";
        form.last_name.value = "Cruz";
        form.date_of_birth.value = "1998-05-15";
        form.age.value = "26"; // Or auto-calculate
        form.barangay.value = "Banale";
        form.previous_employment_1.value = "ABC Corp, Technician";
        form.previous_employment_2.value = "XYZ Inc, Analyst";
        form.current_employment_1.value = "NowWorks, Developer";
        form.current_employment_2.value = "RemoteFirm, Consultant";
        form.future_employment_1.value = "Project Manager, IT";
        form.future_employment_2.value = "Full Stack Developer";
        form.your_skills.value = "JavaScript, Node.js, HTML, CSS";
        form.elementary_education.value = "Banale Elementary, 2010";
        form.high_school_education.value = "Pagadian High, 2014";
        form.college_education.value = "WMSU, 2018";
        form.course_taken.value = "BS in Information Technology";
        form.email.value = "juan.delacruz@example.com";
        form.password.value = "password123";
    }

    function getFormData() {
        const formData = new FormData(form);
        const data = {};
        formData.forEach((value, key) => {
            data[key] = value;
        });
        return data;
    }

    // 🧪 Fill with sample data automatically on load (for demo)
    // fillFormWithSampleData();

    // 🚀 Simulate submission (example: log data)
    form.addEventListener("submit", (e) => {
        e.preventDefault(); 
        const data = getFormData();
        console.log("Form Data Submitted:", data);
        fetch('/api/submitform', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ data: data }),
        })
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                showToast('success', "Application submitted"); 
               
            } else {
                showToast('error', data.message);
            }
        })
        .catch(err => {
            console.error('Error:', err);
            showToast('error', "Something went wrong");
        });
    });
</script>